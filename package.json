{
  "name": "upservice-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "api": "node --env-file-if-exists=.env --watch server/index.js",
    "web": "vite web",
    "build": "vite build web",
    "start": "node --env-file-if-exists=.env server.js",
    "migrate": "node --env-file-if-exists=.env server/migrate.js",
    "make-admin": "node --env-file-if-exists=.env server/make-admin.js",
    "typecheck": "tsc -p web",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "loadtest": "node --env-file-if-exists=.env scripts/loadtest.mjs",
    "backup": "node --env-file-if-exists=.env server/backup.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
