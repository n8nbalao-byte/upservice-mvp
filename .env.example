# Banco MySQL/MariaDB (Hostinger em produção; Docker no desenvolvimento)
DATABASE_URL=mysql://root:dev@localhost:3306/upservice
# Banco descartável usado por npm test (é apagado e recriado a cada execução)
TEST_DATABASE_URL=mysql://root:dev@localhost:3306/upservice_test

PORT=3000
NODE_ENV=development

# Pasta PRIVADA de documentos e selfies. Em produção: fora da pasta do deploy (ex.: /home/<usuario>/upservice-storage)
STORAGE_DIR=./storage

# Google OAuth (Client ID web). Vazio = botão Google não aparece.
GOOGLE_CLIENT_ID=
# Opcional: Geocoding API do Google (coordenadas precisas no cadastro de unidades). Vazio = OpenStreetMap, menos preciso.
GOOGLE_MAPS_API_KEY=
# WhatsApp do suporte (com DDI e DDD, ex.: 5511999999999), usado só sem o número oficial conectado. Vazio: abre o e-mail.
SUPPORT_WHATSAPP=
# API oficial do WhatsApp (Meta). Normalmente configurada na tela Configurações → WhatsApp; estas variáveis, se
# preenchidas, têm prioridade e travam a tela.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Login de desenvolvimento por e-mail, sem senha. NUNCA ligar em produção (o servidor recusa com NODE_ENV=production).
DEV_LOGIN=1

# SMTP da Hostinger. Sem SMTP_USER os e-mails só aparecem no console.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# A mesma conta lê por IMAP quantos e-mails não lidos há (número no menu "E-mail" do administrador).
# IMAP_HOST=imap.hostinger.com
MAIL_FROM=UpService <nao-responda@upserviceintermed.com>
